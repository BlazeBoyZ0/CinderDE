{
  "id": "java",
  "name": "Java",
  "extensions": [
    "java"
  ],
  "keywords": [
    "abstract",
    "assert",
    "boolean",
    "break",
    "byte",
    "case",
    "catch",
    "char",
    "class",
    "const",
    "continue",
    "default",
    "do",
    "double",
    "else",
    "enum",
    "extends",
    "final",
    "finally",
    "float",
    "for",
    "if",
    "goto",
    "implements",
    "import",
    "instanceof",
    "int",
    "interface",
    "long",
    "native",
    "new",
    "package",
    "private",
    "protected",
    "public",
    "return",
    "short",
    "static",
    "strictfp",
    "super",
    "switch",
    "synchronized",
    "this",
    "throw",
    "throws",
    "transient",
    "try",
    "void",
    "volatile",
    "while",
    "var",
    "record",
    "sealed",
    "permits",
    "yield",
    "true",
    "false",
    "null"
  ],
  "types": [
    "String",
    "Object",
    "Integer",
    "Boolean",
    "Character",
    "Double",
    "Float",
    "Long",
    "Short",
    "Byte",
    "List",
    "ArrayList",
    "Map",
    "HashMap",
    "Set",
    "Optional",
    "Exception",
    "RuntimeException"
  ],
  "builtins": [
    "System",
    "Math",
    "StringBuilder",
    "Arrays",
    "Collections",
    "Objects",
    "Scanner"
  ],
  "comments": {
    "line": "//",
    "block_start": "/*",
    "block_end": "*/"
  },
  "indentation": {
    "tab_size": 4,
    "use_spaces": true,
    "auto_indent_on_brace": true
  },
  "build_run": {
    "build_command": "javac \"${file}\"",
    "run_command": "java -cp \"${fileDir}\" \"${fileBase}\""
  }
}

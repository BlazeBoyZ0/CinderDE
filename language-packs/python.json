{
  "id": "python",
  "name": "Python",
  "extensions": [
    "py",
    "pyw",
    "pyi"
  ],
  "keywords": [
    "and",
    "as",
    "assert",
    "async",
    "await",
    "break",
    "class",
    "continue",
    "def",
    "del",
    "elif",
    "else",
    "except",
    "finally",
    "for",
    "from",
    "global",
    "if",
    "import",
    "in",
    "is",
    "lambda",
    "nonlocal",
    "not",
    "or",
    "pass",
    "raise",
    "return",
    "try",
    "while",
    "with",
    "yield",
    "match",
    "case",
    "True",
    "False",
    "None"
  ],
  "types": [
    "int",
    "float",
    "complex",
    "bool",
    "str",
    "bytes",
    "list",
    "tuple",
    "dict",
    "set",
    "frozenset",
    "object",
    "type"
  ],
  "builtins": [
    "print",
    "len",
    "range",
    "enumerate",
    "zip",
    "map",
    "filter",
    "sum",
    "min",
    "max",
    "abs",
    "all",
    "any",
    "open",
    "input",
    "isinstance",
    "super",
    "property"
  ],
  "comments": {
    "line": "#",
    "block_start": "",
    "block_end": ""
  },
  "indentation": {
    "tab_size": 4,
    "use_spaces": true,
    "auto_indent_on_brace": false
  },
  "build_run": {
    "build_command": "python3 -m py_compile \"${file}\"",
    "run_command": "python3 \"${file}\""
  }
}

{
  "id": "typescript",
  "name": "TypeScript",
  "extensions": [
    "ts",
    "tsx"
  ],
  "keywords": [
    "abstract",
    "any",
    "as",
    "asserts",
    "async",
    "await",
    "bigint",
    "boolean",
    "break",
    "case",
    "catch",
    "class",
    "const",
    "constructor",
    "continue",
    "debugger",
    "declare",
    "default",
    "delete",
    "do",
    "else",
    "enum",
    "export",
    "extends",
    "false",
    "finally",
    "for",
    "from",
    "function",
    "get",
    "if",
    "implements",
    "import",
    "in",
    "infer",
    "instanceof",
    "interface",
    "is",
    "keyof",
    "let",
    "module",
    "namespace",
    "never",
    "new",
    "null",
    "number",
    "object",
    "of",
    "package",
    "private",
    "protected",
    "public",
    "readonly",
    "require",
    "return",
    "set",
    "static",
    "string",
    "super",
    "switch",
    "symbol",
    "this",
    "throw",
    "true",
    "try",
    "type",
    "typeof",
    "undefined",
    "unique",
    "unknown",
    "var",
    "void",
    "while",
    "with",
    "yield"
  ],
  "types": [
    "Array",
    "Date",
    "Error",
    "Map",
    "Promise",
    "Record",
    "Readonly",
    "Set",
    "WeakMap",
    "WeakSet"
  ],
  "builtins": [
    "console",
    "JSON",
    "Math",
    "parseInt",
    "parseFloat",
    "setTimeout",
    "setInterval",
    "fetch"
  ],
  "comments": {
    "line": "//",
    "block_start": "/*",
    "block_end": "*/"
  },
  "indentation": {
    "tab_size": 2,
    "use_spaces": true,
    "auto_indent_on_brace": true
  },
  "build_run": {
    "build_command": "tsc --noEmit \"${file}\"",
    "run_command": "node \"${file}\""
  }
}
